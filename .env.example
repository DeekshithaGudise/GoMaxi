# GoMaxi environment template
# The prototype runs fully offline with an in-browser engine. These variables are
# reserved for the production integration path and are NOT required for the demo.

# Backend adapter: "local" (default, in-browser engine) | "supabase" (future)
VITE_BACKEND=local

# Supabase (future) — see supabase/schema.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments (future) — Razorpay or another authorised PA/PG. Never commit live keys.
VITE_RAZORPAY_KEY_ID=

# Maps — OpenStreetMap tiles are used by default (no key). Set a custom tile URL if needed.
VITE_MAP_TILE_URL=

# Demo clock: initial simulated time (IST) when the app starts
VITE_DEMO_START_TIME=2026-11-02T08:55:00+05:30
